# ==============================================================================
# EBD REVISTA MANAGER - PRIMEIRA IGREJA BATISTA DE CATAGUASES
# Arquivo de Configuração de Variáveis de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env.local (em desenvolvimento) ou .env (em produção/Docker)
# e preencha com as suas credenciais reais.
#
# NUNCA envie o arquivo .env preenchido para o GitHub ou controle de versão!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Banco de Dados e Autenticação)
# ------------------------------------------------------------------------------
# Obtenha estas credenciais no painel do seu projeto Supabase:
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-publica-anon-aqui"

# Chave de Serviço (Service Role Key) - NUNCA expor no frontend!
# Necessária para o backend e tarefas agendadas (cron) executarem operações administrativas.
SUPABASE_SERVICE_ROLE_KEY="sua-chave-secreta-service-role-aqui"

# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÃO DA APLICAÇÃO E URL PÚBLICA
# ------------------------------------------------------------------------------
# URL base utilizada para gerar os links diretos enviados nas mensagens de WhatsApp
# Em desenvolvimento: http://localhost:3000
# No Umbrel OS / rede local: http://umbrel.local:3001 ou o IP local (ex: http://192.168.1.150:3001)
# Com domínio próprio / Cloudflare Tunnel: https://ebd.pibcataguases.com.br
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Diretório de armazenamento persistente dos arquivos PDF locais
# Em ambiente local: ./data/uploads
# No Docker / Umbrel OS: /app/data/uploads
UPLOAD_DIR="./data/uploads"

# Porta onde a aplicação responderá
APP_HOST_PORT=3001

# ------------------------------------------------------------------------------
# 3. AGENDADOR / CRON
# ------------------------------------------------------------------------------
# Token secreto para proteger a rota de disparo manual/externo do cron (/api/cron/check-scheduled)
# Crie uma senha forte e aleatória.
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 4. INTEGRAÇÃO WHATSAPP (Evolution API / Webhook Self-Hosted)
# ------------------------------------------------------------------------------
# Provedor padrão: 'evolution' (Evolution API v2) ou 'webhook' (endpoint HTTP genérico)
WHATSAPP_PROVIDER="evolution"

# URL da Evolution API:
# Se estiver rodando no mesmo docker-compose: http://evolution-api:8080
# Se estiver rodando separadamente: http://localhost:8080 ou http://192.168.1.150:8080
WHATSAPP_API_URL="http://localhost:8080"

# Chave de API definida na Evolution API (AUTHENTICATION_API_KEY)
WHATSAPP_API_KEY=""

# Nome da instância criada na Evolution API para conectar o WhatsApp
WHATSAPP_INSTANCE="pib-cataguases-ebd"

# ID do grupo de destino do WhatsApp (JID do grupo, termina com @g.us)
# Ou número de telefone com DDI e DDD (ex: 5532999999999) para testes individuais
WHATSAPP_GROUP_JID="120363000000000000@g.us"

# Mensagem padrão disparada na liberação da revista da semana
# Variáveis disponíveis para interpolação:
# {titulo} -> Título da revista / lição
# {data}   -> Data do domingo formatada (ex: 01/11/2026)
# {link}   -> Link direto para leitura online e download
WHATSAPP_DEFAULT_MESSAGE="📖 *Escola Bíblica Dominical - PIB Cataguases*\n\nA Paz do Senhor! Já está disponível a revista da EBD para o estudo desta semana!\n\n📌 *{titulo}*\n📅 *Data:* {data}\n\n👉 Acesse agora para ler online ou baixar o PDF:\n{link}\n\n_\"Lâmpada para os meus pés é tua palavra, e luz para o meu caminho.\" (Sl 119:105)_"
